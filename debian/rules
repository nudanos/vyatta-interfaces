#!/usr/bin/make -f
#
# This debian/rules uses debhelper.
#

# notify-intf is built GOPATH-style (notify-intf/Makefile.am); Go 1.26
# defaults to module mode.
export GO111MODULE := off

CFLAGS += -Wall -Wextra -Werror

override_dh_auto_configure:
	dh_auto_configure -- --prefix=/opt/vyatta --sysconfdir=/opt/vyatta/etc CFLAGS="$(CFLAGS)"

# verbose output of unittest logs
override_dh_auto_test:
	dh_auto_test -- VERBOSE=1

override_dh_install:
	dh_install

%:
	dh $@ --with autoreconf,yang,python3
